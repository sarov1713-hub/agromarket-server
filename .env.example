PORT=3000
DATABASE_URL=postgresql://postgres:password@192.168.157.165:5432/agromarket
CORS_ORIGINS=http://localhost:5173
# Production: http://localhost:5173,https://agromarket-react.vercel.app
# CORS_ORIGIN поддерживается как прежнее имя при отсутствии CORS_ORIGINS.
# Render задаёт RENDER=true автоматически; только там доверяем одному proxy hop.

JWT_SECRET=change-me
JWT_EXPIRES_IN=2h
ADMIN_EMAIL=admin@agromarket.kz
ADMIN_PASSWORD=change-me
# Для отдельной временной тестовой БД: TEST_ENV_FILE=<absolute path to test env>
# Проверка строго имени agromarket_test действует и для этого файла.
